{
  "name": "@sla/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "replay:l2": "tsx scripts/l2-replay.ts",
    "perf:baseline": "dotenv -e ../../.env -- tsx scripts/perf-baseline-cycle.ts",
    "type-check:scripts": "tsc -p tsconfig.scripts.json",
    "seed:test-customers": "dotenv -e ../../.env -- tsx scripts/seed-test-customers/cli.ts seed",
    "seed:test-customers:validate": "dotenv -e ../../.env -- tsx scripts/seed-test-customers/cli.ts validate"
  },
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "@sla/commitments": "workspace:*",
    "@sla/custom-ticket": "workspace:*",
    "@sla/db": "workspace:*",
    "@sla/email": "workspace:*",
    "@sla/github": "workspace:*",
    "@sla/ingestion": "workspace:*",
    "@sla/intercom": "workspace:*",
    "@sla/jira": "workspace:*",
    "@sla/linear": "workspace:*",
    "@sla/logger": "workspace:*",
    "@sla/notifications": "workspace:*",
    "@sla/zendesk": "workspace:*"
  },
  "devDependencies": {
    "@sla/core": "workspace:*",
    "@types/node": "^26.4.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
