{
  "name": "@sla/commitments",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "backfill:breached-at": "dotenv -e ../../.env -- tsx src/scripts/backfill-breached-at.ts",
    "repair:first-response-start": "dotenv -e ../../.env -- tsx src/scripts/repair-first-response-start.ts"
  },
  "dependencies": {
    "@sla/core": "workspace:*",
    "@sla/db": "workspace:*",
    "@sla/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
