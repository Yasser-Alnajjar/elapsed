/// Singleton row (`id` is always `"singleton"`) holding the worker's
/// persisted polling configuration and last-observed run state — see
/// `@sla/db`'s `worker-settings.ts`. Several worker processes may run (each
/// organization is leased to one at a time, see `OrganizationWorkState`), and
/// they all read this one row: the two intervals apply to every organization (each
/// organization's own next-due times live in `OrganizationWorkState`), so this
/// config is deliberately global rather than living on `Organization`.
/// `reconciliationIntervalMs` is capped at 30 minutes wherever it is read,
/// whatever value is stored here. `activePollIntervalMs`/`reconciliationIntervalMs` start
/// out equal to the `WORKER_ACTIVE_POLL_MS`/`WORKER_RECONCILIATION_MS` env
/// vars (bootstrap defaults for a fresh install); once a platform operator
/// (see `PLATFORM_ADMIN_EMAILS`, `apps/web/src/lib/authz.ts`) saves a
/// change from the Monitoring settings page, this row is authoritative and
/// the env vars are no longer consulted.
model WorkerSettings {
  id                         String    @id @default("singleton")
  activePollIntervalMs       Int
  reconciliationIntervalMs   Int
  /// Written by every worker process from its claim loop and after each
  /// organization run — proof that at least one process is alive and looping.
  /// Used to tell "stopped" apart from "degraded".
  lastHeartbeatAt            DateTime?
  /// The start time of the most recent organization run (of either kind)
  /// that completed, only ever moving forward; `lastActivePollFailures` is
  /// the number of organizations currently failing, read from
  /// `OrganizationWorkState`, not a retry counter. Per-organization detail
  /// lives there; these are the deployment-wide summary.
  lastActivePollAt           DateTime?
  lastActivePollFailures     Int?
  lastReconciliationAt       DateTime?
  lastReconciliationFailures Int?
  /// Legacy: written by the single-lane scheduler at the moment it armed a
  /// timer. Workers no longer write these — with per-organization schedules
  /// there is no single timer — and the Monitoring read model takes the
  /// earliest `OrganizationWorkState.*NextDueAt` instead. Kept (not dropped)
  /// so the column set stays backward compatible for a rolling deploy.
  nextActivePollAt           DateTime?
  nextReconciliationAt       DateTime?
  /// Fresh when an integration succeeded within this many active-poll
  /// intervals. Kept operator-only because it changes alert caveats, not SLA
  /// calculations.
  freshnessGraceFactor       Int       @default(3)
  /// Operator kill switch for the monthly customer report (N5.6). On by
  /// default; off, the worker sends no report and records nothing. It never
  /// touches monitoring or alerting.
  monthlyReportEnabled       Boolean   @default(true)
  /// Operator switch for plan-limit enforcement (N6.3, N6.4). Off by default:
  /// off, creation points behave exactly as before and no entitlement event is
  /// written. On, an over-limit creation warns and a lapsed trial blocks new
  /// configuration. It never touches ingestion, evaluation or alerting.
  entitlementsEnforced       Boolean   @default(false)
  lastActivePollDurationMs   Int?
  lastReconciliationDurationMs Int?

  @@map("worker_settings")
}

/// Which of the two per-organization polling jobs a lease was claimed for.
/// Reconciliation is a strict superset of active work (same ingestion, full
/// re-derivation instead of incremental), which is why one lease covers both
/// and a reconciliation run also satisfies the organization's active slot.
enum OrganizationWorkKind {
  active
  reconciliation
}

/// Per-organization scheduling state and lease — the only coordination
/// between worker processes (no Redis or external queue). One row per
/// organization, claimed atomically by whichever worker finds it due
/// (`FOR UPDATE SKIP LOCKED`, see `packages/db/src/organization-work-state.ts`).
///
/// The lease is what makes provider ingestion — which advances
/// `Integration.cursor` — safe with several workers: only the lease holder
/// touches an organization. `leaseToken` is a fencing token, incremented on
/// every claim: completing, renewing or releasing work is a compare-and-set on
/// (`leaseOwner`, `leaseToken`), so a worker whose lease expired and was
/// re-claimed can no longer record results, and checks it against the row
/// before its irreversible steps. The per-organization advisory lock
/// (`withOrganizationSlaLock`) is kept as the backstop for the projection
/// phase, where webhooks and onboarding also write.
///
/// All instants are compared against the database's own clock (`now()`), never
/// a worker's, so skew between workers cannot make a lease look expired early.
/// Due times are start-to-start: `activeNextDueAt` is the claim's start plus the
/// active interval, so an overrun organization is simply due again on
/// completion (one run, never a catch-up burst).
model OrganizationWorkState {
  organizationId               String                @id
  /// When the next active poll for this organization is due.
  activeNextDueAt              DateTime              @default(now()) @db.Timestamptz(3)
  /// When the next reconciliation is due; never later than the configured
  /// interval (max 30 minutes) after the previous one started.
  reconciliationNextDueAt      DateTime              @default(now()) @db.Timestamptz(3)
  /// Identity of the worker process holding the lease; null when unleased.
  leaseOwner                   String?
  leaseKind                    OrganizationWorkKind?
  /// Fencing token: incremented on every successful claim.
  leaseToken                   BigInt                @default(0)
  /// The lease is reclaimable once this passes (a crashed holder's way out).
  leaseExpiresAt               DateTime?             @db.Timestamptz(3)
  lastStartedAt                DateTime?             @db.Timestamptz(3)
  lastFinishedAt               DateTime?             @db.Timestamptz(3)
  lastActiveFinishedAt         DateTime?             @db.Timestamptz(3)
  lastReconciliationFinishedAt DateTime?             @db.Timestamptz(3)
  /// Runs in a row that recorded a failure (a failed stage, a thrown error,
  /// or an abandoned lease); reset by a clean run.
  consecutiveFailures          Int                   @default(0)
  lastFailureAt                DateTime?             @db.Timestamptz(3)
  lastError                    String?
  organization                 Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([activeNextDueAt])
  @@index([reconciliationNextDueAt])
  @@index([leaseExpiresAt])
  @@map("organization_work_states")
}

/// Delivery state of one organization's monthly report on one channel (N5.6).
/// The unique key `(organizationId, period, channel)` is the idempotency key:
/// claiming a month is an insert, so two ticks, or two workers, send once.
enum ReportDeliveryStatus {
  /// Claimed by a worker that is sending it now (or died doing so: see `updatedAt`).
  pending
  sent
  /// The last attempt failed; `error` says why. Retried a bounded number of times.
  failed
  /// Nothing to send on this channel (no email settings, Slack not connected).
  skipped
}

model ReportDelivery {
  id             String               @id @default(cuid())
  organizationId String
  /// The calendar month reported, in the organization's own timezone: `2026-09`.
  period         String
  /// `email` or `slack`.
  channel        String
  status         ReportDeliveryStatus @default(pending)
  attempts       Int                  @default(1)
  deliveredAt    DateTime?
  /// Why the last attempt failed. Never holds report content or a recipient's data.
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, channel])
  @@index([status, updatedAt])
  @@map("report_deliveries")
}

/// A signed, expiring, single-use link that lets someone who is not a member
/// complete one provider's OAuth for one organization (N5.3, D26). The token
/// is shown once when an owner creates it; only its hash is stored. It grants
/// no account and no session: it can only finish that one grant.
model IntegrationConnectLink {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider
  tokenHash       String              @unique
  /// Who the owner meant it for ("Dana, platform team"). Free text, shown on the landing page.
  intendedFor     String?
  /// The owner who created it; null if that user was removed since.
  createdByUserId String?
  expiresAt       DateTime
  /// Set, atomically, by the callback that stored the integration. A consumed link is dead.
  consumedAt      DateTime?
  createdAt       DateTime            @default(now())
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, createdAt])
  @@map("integration_connect_links")
}

/// A durable, tenant-scoped record of every override of a normalization safety
/// guard (N9, plan 09 6.11): the customer path (organization owner) and the
/// support-assisted path. Only the mass lifecycle change guard can be
/// overridden; a mass deletion never can. Single use, expiring, bound to the
/// exact preview (a hash of the aborted pass's record set). Not pruned with
/// the 30-day sync history and not `AdminAuditLog`, which is platform-side.
model GuardOverride {
  id                 String       @id @default(cuid())
  organizationId     String
  integrationId      String
  /// `mass_lifecycle_change` is the only value the engine honors.
  guard              String
  /// Hash of the guard and the sorted ids of the records the preview showed.
  previewHash        String
  /// `R`, `L`, ratio and the like: counts only.
  counts             Json
  reason             String
  /// `customer` or `support_assisted`.
  path               String
  requestedByUserId  String
  /// Support path: the organization owner who authorized this exact preview.
  authorizedByUserId String?
  operatorEmail      String?
  /// When the confirmation completed; the engine honors only confirmed rows.
  confirmedAt        DateTime?
  expiresAt          DateTime
  consumedAt         DateTime?
  /// `applied`, `void` (the record set changed) or `expired`.
  outcome            String?
  createdAt          DateTime     @default(now())
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration        Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, guard, consumedAt])
  @@index([organizationId, createdAt])
  @@map("guard_overrides")
}

/// Who activated or rolled back which `custom` configuration version, and what it
/// cost (N9, plan 09 5.5 and 5.6): the counts of commitments the activation
/// cancelled and the preview hash the owner confirmed. Append-only, tenant
/// scoped (there is no organization-level audit log; `AdminAuditLog` is
/// platform-side). Holds counts and ids only, never configuration or secrets.
model CustomActivationAudit {
  id             String       @id @default(cuid())
  organizationId String
  integrationId  String
  /// `activate` or `rollback`.
  action         String
  fromVersion    Int?
  toVersion      Int
  userId         String
  /// `{ cancelledByKind, keptFinalized, remainsCancelled, previewHash }`: counts and a hash.
  details        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration    Integration  @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@map("custom_activation_audits")
}
