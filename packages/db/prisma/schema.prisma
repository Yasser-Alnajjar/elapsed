// Prisma schema + generated client. No business logic lives here — the SLA/OLA
// engine in packages/core is pure and knows nothing about this file.
//
// The one rule this schema exists to enforce: store events, never store
// computed time. RawEvent and NormalizedEvent are append-only; elapsed time,
// deadlines, and breach status are always derived, never persisted as a
// mutable counter. Breach is not a table — it's an Evaluation with
// status = "breached".

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String             @id @default(cuid())
  name              String
  /// Display-only grouping for the dashboard (Phase 6 roadmap 6.5) — never
  /// read by SLA calculations, which stay pinned to each calendar's own
  /// timezone (see `packages/commitments/src/pipeline.ts`). Defaults to UTC
  /// so every pre-existing organization gets a valid value on migration.
  timezone          String             @default("UTC")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// Optional OLA target (Phase 15 roadmap step 16): minutes a case may spend
  /// in the engineering leg before it shows as at-risk/breached. Null means
  /// no target is configured — deliberately a single org-scoped value, not a
  /// policy builder or a per-team entity.
  engineeringLegTargetMinutes Int?
  /// Pre-filled calendar choice when creating a native policy or calendar
  /// (Phase 4 task 4.7) — not part of runtime commitment calendar
  /// resolution, which stays customer-override-then-matched-policy exactly
  /// as before (see packages/commitments/src/pipeline.ts).
  defaultCalendarId String?
  defaultCalendar   BusinessCalendar?  @relation("OrganizationDefaultCalendar", fields: [defaultCalendarId], references: [id], onDelete: SetNull)
  businessCalendars BusinessCalendar[]
  cases             Case[]
  customers         Customer[]
  integrations      Integration[]
  integrationConfigs IntegrationConfig[]
  slaPolicies       SLAPolicy[]
  slaImportSummary  SlaImportSummary?
  slackIntegration  SlackIntegration?
  emailSettings     OrganizationEmailSettings?
  users             User[]
  invitations       OrganizationInvitation[]

  @@map("organizations")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  /// Null until the current `email` has been proven reachable (roadmap
  /// 5.6) — set by `verifyEmail` when a signup-verification token is
  /// consumed, or carried forward automatically when an email *change*
  /// token is consumed (the new address is only ever written to this
  /// column once it's already been verified, so it can never regress to
  /// unverified). An invitation-accepted user (5.2) is marked verified
  /// immediately at account creation — clicking that emailed link is
  /// already proof of control over the address, so there's no separate
  /// verification step for them to do.
  emailVerifiedAt DateTime?
  passwordHash   String
  /// Bumped whenever a live JWT session for this user must stop working
  /// before its own expiry (roadmap 5.7): a password change or reset.
  /// `auth.ts`'s `jwt` callback re-checks this against the value baked
  /// into the token on every `getServerSession` call (not just at
  /// sign-in) and throws if they no longer match — see that file's doc
  /// comment for exactly how NextAuth turns that throw into a cleared
  /// session. Removal needs no bump of its own: the `User` row is gone
  /// entirely, and the same re-check throws on "no such user" too.
  sessionVersion Int          @default(0)
  name           String?
  image          String?
  /// Set at sign-up when the user checks the terms/privacy-policy checkbox.
  /// Null for users created before this field existed or via invitation
  /// (roadmap 5.2), which has no terms checkbox of its own.
  acceptedTermsAt DateTime?
  /// `owner` is whoever created the organization (roadmap: Worker/Monitoring
  /// settings) — the only role distinction v1 needs. Sign-up creates the
  /// owner; every invitation accepted (Phase 5 task 5.2) creates a `member`
  /// — no way to invite someone as `owner` yet. Gates admin-only actions;
  /// `member` is otherwise identical in what it can view.
  role           UserRole     @default(member)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Invitations this user has sent (as an inviter) and the one invitation
  /// that, if any, this user's own account was created from.
  invitationsSent    OrganizationInvitation[] @relation("InvitationsSent")
  invitationAccepted OrganizationInvitation?  @relation("InvitationAccepted")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([organizationId])
  @@map("users")
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

/// A single-use, expiring token for the "forgot password" flow (roadmap
/// 5.5) — same shape as `OrganizationInvitation` (only `tokenHash` is ever
/// stored; the raw token exists solely in the emailed link, see
/// `@sla/db`'s `secure-token.ts`), but scoped to an existing `User` instead
/// of an email that may not have an account yet. `usedAt` (rather than a
/// status enum) is enough state for this model — there's no "revoked"
/// concept, and requesting a new reset simply deletes any prior unused
/// tokens for the same user (see `requestPasswordReset`) instead of
/// tracking a superseded status.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// A single-use, expiring token for both halves of roadmap 5.6: verifying
/// the account's current email (`newEmail` null), and confirming a
/// requested change to a new one (`newEmail` set — `User.email` is only
/// ever written to once this token is consumed, never at request time, so
/// a typo'd or someone-else's address can't take over the account just by
/// being entered into the "change email" form). Same shape as
/// `PasswordResetToken` — `usedAt`, not a status enum, is enough state,
/// and only `tokenHash` is ever stored.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// A single-use, expiring invitation to join an organization as a `member`
/// (roadmap 5.2). Deliberately its own entity rather than encoding
/// "invited but not yet a user" state onto `User` — a pending invitation
/// has no `User` row at all until accepted, so there's nothing on `User`
/// to encode it into. Only a hash of the raw token is ever stored; the raw
/// token exists solely in the acceptance URL/email (see
/// `@sla/db`'s `secure-token.ts`). At most one `pending` invitation may
/// exist per `(organizationId, email)` — enforced by a partial unique
/// index added by raw SQL in this model's migration (Prisma's schema DSL
/// has no `WHERE` clause for `@@unique`) — so resending an invitation
/// updates the existing pending row (rotating its token) rather than
/// creating a second, simultaneously-valid one.
model OrganizationInvitation {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Normalized (trim + lowercase), matching `User.email`'s own convention
  /// — never trusted as unique on its own; uniqueness among *pending*
  /// invitations is scoped per organization (see this model's own doc
  /// comment), and an accepted/revoked invitation is never unique at all.
  email            String
  /// SHA-256 hex digest of the single-use raw token.
  tokenHash        String            @unique
  status           InvitationStatus  @default(pending)
  /// Nullable + `SetNull` on delete (not `Restrict`): once 5.3 can remove a
  /// member, that member having sent invitations in the past must never
  /// block their own removal — the invitation row survives as history, just
  /// with its inviter reference cleared.
  invitedByUserId  String?
  invitedBy        User?             @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  expiresAt        DateTime
  acceptedAt       DateTime?
  /// Set exactly when `status` becomes `accepted` — the `User` row this
  /// invitation's acceptance created. `SetNull` for the same reason as
  /// `invitedByUserId`: removing that member later must not be blocked.
  acceptedByUserId String?           @unique
  acceptedBy       User?             @relation("InvitationAccepted", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  revokedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, status])
  @@map("organization_invitations")
}

model Integration {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  credentials    Json?
  cursor         Json?
  connectedAt    DateTime            @default(now())
  /// Lifecycle state (roadmap step 17). `reauth_required` mirrors the
  /// provider-specific `credentials.reauthRequired` flag each package's
  /// tokenLifecycle.ts already sets — kept in sync here so the settings UI
  /// and worker can read integration health without unpacking per-provider
  /// JSON. `permission_denied` (roadmap step 32) has no credentials-JSON
  /// counterpart — the credentials are fine, the provider-side access isn't.
  /// Disconnect is always a soft transition to `disconnected`, never a
  /// row delete: `RawEvent.integrationId` cascades on delete and would
  /// destroy the immutable replay log this row anchors.
  status         IntegrationStatus   @default(connected)
  /// Set when disconnect runs; cleared back to null on reconnect.
  disconnectedAt DateTime?
  /// Persisted every worker cycle attempt (success or failure) so the
  /// settings page can show real sync health instead of only stdout logs.
  lastSyncAt     DateTime?
  lastSyncError  String?
  /// Generated at first connect (roadmap step 20) and backfilled on
  /// reconnect if still null (roadmap step 26) — but never rotated once
  /// set. The customer pastes this into their Zendesk/Jira webhook config
  /// to authenticate inbound calls to /api/webhooks/{provider}/{id}, so it
  /// must survive a disconnect/reconnect cycle like connectedAt does. Null
  /// only for linear (no webhook receiver exists for it).
  webhookSecret  String?
  /// Incremental-normalization watermark (roadmap 7.7 Phase 3): the greatest
  /// `(RawEvent.fetchedAt, RawEvent.id)` the last normalization pass had
  /// seen — a deterministic cursor, since `fetchedAt` alone can tie. The
  /// active-set poll only re-derives tickets touched by RawEvents after this
  /// point (minus an overlap window, because webhook and backfill inserts can
  /// commit out of `fetchedAt` order). Null until the first full pass. Only
  /// Zendesk uses it so far.
  normalizedThroughFetchedAt DateTime?
  normalizedThroughId        String?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rawEvents      RawEvent[]

  @@unique([organizationId, provider])
  @@map("integrations")
}

/// Exactly what the provider returned, with fetch time and a source hash.
/// Immutable, append-only. Retained for replay — never queried by the engine.
model RawEvent {
  id               String            @id @default(cuid())
  integrationId    String
  providerEventId  String
  sourceHash       String
  payload          Json
  fetchedAt        DateTime          @default(now())
  createdAt        DateTime          @default(now())
  normalizedEvents NormalizedEvent[]
  integration      Integration       @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, providerEventId])
  @@index([integrationId, fetchedAt])
  @@map("raw_events")
}

/// Provider-independent fact. The SLA/OLA engine's only input. Immutable —
/// regenerate by re-deriving from RawEvent, never by editing in place.
model NormalizedEvent {
  id               String              @id @default(cuid())
  caseId           String
  sourceRawEventId String
  type             String
  occurredAt       DateTime
  actor            String
  system           IntegrationProvider
  /// What this event's source plays in the case: `ticket_source`,
  /// `work_tracker` or `code_host`. The engine decides by this, not by
  /// `system` (N1.5). Derived data: the backfill equals re-derivation.
  sourceRole       String
  fromState        String?
  toState          String?
  /// Position in the provider's own source order (Zendesk audit order, then
  /// the event's index inside the audit), breaking ties between events that
  /// share an occurredAt. Only comparable within one system on one case.
  /// Rows written before this column existed hold 0 until renormalized.
  sourceSequence   Int                 @default(0)
  createdAt        DateTime            @default(now())
  case             Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sourceRawEvent   RawEvent            @relation(fields: [sourceRawEventId], references: [id])

  @@index([caseId, occurredAt])
  @@map("normalized_events")
}

/// Derived from Zendesk organizations or Intercom companies. Never manually entered.
model Customer {
  id                String       @id @default(cuid())
  organizationId    String
  name              String
  zendeskOrgId      String?
  /// Intercom company id (roadmap step 22) — a separate optional key from
  /// `zendeskOrgId` rather than a shared generic column, since an org that
  /// somehow connected both ticket sources must never collide a Zendesk
  /// organization and an unrelated Intercom company onto the same Customer
  /// row just because they reused the same upstream numeric id.
  intercomCompanyId String?
  /// Intercom contact id — the fallback key for a conversation whose primary
  /// contact belongs to no company (common for self-serve/Messenger users),
  /// so the case still gets a real customer instead of none. Only ever set
  /// when `intercomCompanyId` is not.
  intercomContactId String?
  tier              String?
  /// Optional override (roadmap step 24): which `BusinessCalendar` this
  /// customer's commitments are anchored to, in place of whatever the
  /// matched `SLAPolicyVersion` would otherwise resolve to — e.g. a
  /// contractually 24/7 enterprise tier calendar instead of the org's
  /// standard-hours schedule. Null means no override; resolution stays
  /// per-org exactly as before. Must reference a `BusinessCalendar` in the
  /// same organization (enforced in `packages/commitments`, not the schema).
  calendarId        String?
  /// The specific `BusinessCalendarVersion` frozen in at the moment
  /// `setCustomerCalendar` last assigned `calendarId` (4d) — kept in lockstep
  /// with `calendarId` (set/cleared together), so this override pins to a
  /// calendar version exactly like a native policy's own explicit calendar
  /// assignment does, instead of silently picking up a newer version on
  /// every commitment-creation run. A later calendar edit only takes effect
  /// once the override is explicitly re-set (even to the same calendar).
  calendarVersionId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  cases             Case[]
  calendar          BusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  calendarVersion   BusinessCalendarVersion? @relation("CustomerCalendarVersion", fields: [calendarVersionId], references: [id], onDelete: SetNull)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, zendeskOrgId])
  @@unique([organizationId, intercomCompanyId])
  @@unique([organizationId, intercomContactId])
  @@map("customers")
}

/// The unit of customer commitment — one customer request, spanning systems.
/// A mutable projection; the source of truth for its history is the
/// NormalizedEvent stream, not this row's current field values.
model Case {
  id               String            @id @default(cuid())
  organizationId   String
  customerId       String?
  externalId       String
  /// Which ticket-source integration created this case (roadmap step 22:
  /// Intercom joined Zendesk as a second possible source). Set once at
  /// creation and never changed — used to pick the right outbound ticket
  /// link (case-detail-data.ts, report-data.ts) instead of the old
  /// always-Zendesk assumption. Deliberately NOT part of the unique key
  /// below: Jira/Linear's correlator looks up a case by externalId alone,
  /// with no way to know in advance which ticket source created it. An org
  /// that connects two ticket sources whose externalIds happen to collide is
  /// an accepted, uncommon edge case (the product positions Zendesk and
  /// Intercom as alternatives, not both at once — plans/02), not one this
  /// column tries to prevent.
  system           IntegrationProvider @default(zendesk)
  /// The source ticket's subject/title (e.g. Zendesk's `subject` field).
  /// Display-only — never used for matching or correlation. Null for cases
  /// whose source system was ingested before this column existed, or whose
  /// ticket-source normalizer doesn't populate it yet.
  subject          String?
  /// The source ticket's requester/submitter display name (e.g. a Zendesk
  /// ticket's requester). Display-only, exactly like `subject` — never used
  /// for matching, correlation, or Customer resolution. Deliberately NOT a
  /// Customer: Customer stays account/company-only (Zendesk Organization /
  /// Intercom Company), so a ticket with no organization has `customerId:
  /// null` here rather than a Customer row synthesized from the requester.
  /// Null for cases from a source/normalizer that doesn't populate it.
  requesterName    String?
  /// The source ticket's currently-assigned agent display name (Zendesk
  /// `assignee_id` resolved via the ticket's `users` sideload, Intercom
  /// `admin_assignee_id` resolved via the workspace's admin list). Display
  /// only (D10/3.6) — never used for matching, correlation, or routing; only
  /// the name is stored, never the provider's numeric id. Null for a case
  /// with no current assignee, or from a source/normalizer that doesn't
  /// resolve it.
  assigneeName     String?
  priority         String?
  tier             String?
  channel          String?
  /// The source ticket's tags (e.g. a Zendesk ticket's `tags`), used only as
  /// a generic SLA policy match input (`SLAPolicyMatch.conditions`,
  /// packages/core) — never for display or correlation. Empty for cases from
  /// a source/normalizer that doesn't populate it, or a ticket with no tags.
  tags             String[]          @default([])
  /// Generic, source-specific SLA policy match inputs that don't warrant
  /// their own column (e.g. a Zendesk ticket's `status`, `type`, `group_id`,
  /// `assignee_id`, `custom_fields_<id>`, ... — see `zendeskConditionAttributes`,
  /// packages/zendesk/src/normalize.ts) — never for display or correlation.
  /// Canonical fields that already have a dedicated column (priority, tags,
  /// channel, customerId, tier) are NOT duplicated in here; `toCaseAttributes`
  /// (packages/commitments) merges both into one match input at read time.
  /// The exception is a provider's own field-name aliases of those columns
  /// (Zendesk's `current_tags`, `via_id`, `current_via_id`): the adapter
  /// writes them here (N1.10), so the commitments layer knows none of them.
  /// Null for cases from a source/normalizer that doesn't populate it.
  attributes       Json?
  openedAt         DateTime
  closedAt         DateTime?
  /// Set when the source ticket no longer exists in the ticket-source system
  /// (Zendesk deletion webhook, or a 404 on direct refetch). The row and its
  /// history are kept for audit purposes but excluded from SLA evaluation and
  /// default case views.
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  caseLinks        CaseLink[]
  customer         Customer?         @relation(fields: [customerId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commitments      Commitment[]
  legSpans         LegSpan[]
  normalizedEvents NormalizedEvent[]

  @@unique([organizationId, externalId])
  @@index([organizationId, openedAt])
  @@map("cases")
}

/// A binding between a Case and an external record (e.g. a Jira issue).
/// Only `confidence = certain` links contribute to a commitment's leg timing
/// (Phase 15) — the engine in packages/core enforces this, not this table.
model CaseLink {
  id          String              @id @default(cuid())
  caseId      String
  system      IntegrationProvider
  externalId  String
  method      CaseLinkMethod
  confidence  LinkConfidence
  evidence    Json?
  confirmedAt DateTime?
  /// Set when every evidence source that once confirmed this relationship
  /// has stopped confirming it (e.g. the ticket was unlinked from the issue
  /// in Zendesk, and no `remote_link` independently still proves it) —
  /// null means currently active. Mirrors the row-stays-but-marked-inactive
  /// convention already used elsewhere in this schema (`Case.deletedAt`,
  /// `SLAPolicy.archivedAt`): the row, its `method`/`confidence`/`evidence`
  /// history, and every RawEvent/NormalizedEvent derived from it are never
  /// deleted — only whether the relationship is *currently* active changes.
  /// A later re-link clears this back to null on the same row rather than
  /// creating a second one, since CaseLink identity (`caseId`, `system`,
  /// `externalId`) is already the Jira issue itself, not a point-in-time
  /// observation of it.
  unlinkedAt  DateTime?
  createdAt   DateTime            @default(now())
  case        Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, system, externalId])
  @@map("case_links")
}

/// Editing creates a new version; old versions are never destroyed.
model SLAPolicy {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime           @default(now())
  externalId     String?
  /// Set when the source policy (e.g. deleted/deactivated in Zendesk) is no
  /// longer live. Archived policies are excluded from matching for new and
  /// re-resolved commitments, but their versions stay readable — already
  /// created commitments keep the frozen policyVersionId they were matched
  /// under (Phase 13.1), unaffected by archival.
  archivedAt     DateTime?
  /// Zendesk's own evaluation order (D6/1.10) — lower matches first. Set only
  /// for imported policies whose Zendesk payload carried `position`; null for
  /// manually-created policies and older snapshots, which fall back to
  /// specificity (`matchPolicyVersion`, packages/core).
  position       Int?
  /// Imported vs native (D12, Phase 4). Backfilled from `externalId` for
  /// every pre-Phase-4 row: non-null externalId -> imported.
  source         PolicySource       @default(native)
  /// Which provider an imported policy came from (N1.11), so it prices only
  /// that provider's cases (`matchPolicyVersion`). Null for a native policy,
  /// which is a candidate for every case.
  sourceProvider IntegrationProvider?
  /// An owner's own pause/resume of a native policy (Phase 4 task 4.4).
  /// Distinct from `archivedAt`, which means "gone from Zendesk" and never
  /// applies to a native policy.
  deactivatedAt  DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       SLAPolicyVersion[]

  @@unique([organizationId, externalId])
  @@map("sla_policies")
}

model SLAPolicyVersion {
  id                String                  @id @default(cuid())
  policyId          String
  version           Int
  match             Json
  targets           Json
  pauseOnStates     String[]
  calendarVersionId String
  /// Whether a calendar was explicitly chosen for this version (4i) — a
  /// native policy version created/edited without picking a calendar has
  /// this `false`. `calendarVersionId` above always holds a usable version
  /// either way (an explicit pin when this is `true`, otherwise a snapshot
  /// resolved at save time purely for display/backward compatibility); only
  /// when this is `true` does a *new* commitment freeze onto
  /// `calendarVersionId` itself — otherwise commitment creation re-resolves
  /// fresh to the organization's current default calendar, or the system
  /// Always Open calendar (`resolveEffectiveCalendarVersion`,
  /// packages/commitments). Defaults to `true` — at the database level, not
  /// just in Prisma Client — so every pre-4i version, and any row written
  /// without knowing this field exists at all (direct inserts, test
  /// fixtures), keeps its calendar pinned exactly as before; only
  /// `createNativePolicy`/`updateNativePolicy` ever write `false`, and only
  /// when the caller explicitly leaves the calendar unset.
  calendarIsExplicit Boolean                @default(true)
  warnAtPercent     Int[]
  effectiveFrom     DateTime
  /// `imported` versions mirror the provider's policy; `override` versions are
  /// manual target edits on top of one; `native` versions belong to a policy
  /// that was never imported (Phase 4 / D12). The importer only compares
  /// against the latest `imported` version, so re-importing an unchanged
  /// policy never reverts an override.
  source            VersionSource           @default(imported)
  createdAt         DateTime                @default(now())
  commitments       Commitment[]
  calendarVersion   BusinessCalendarVersion @relation(fields: [calendarVersionId], references: [id])
  policy            SLAPolicy               @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@map("sla_policy_versions")
}

/// One row per organization, overwritten on every SLA policy import
/// (Phase 1.12 / E-8, E-16): what the last import silently dropped or
/// couldn't place, so it can reach the UI instead of only logs. A snapshot
/// of the *last run*, not a history — each field is what that run reported.
model SlaImportSummary {
  id                              String   @id @default(cuid())
  organizationId                  String   @unique
  /// Reserved for filter conditions the importer can't represent at all;
  /// currently always 0 — every condition field is preserved generically
  /// (see `extractMatchFromFilter`, packages/zendesk), though only fields
  /// with a matching Case attribute (priority, organization/customerIds,
  /// tags) actually influence matching.
  unsupportedConditions           Int      @default(0)
  /// Zendesk SLA metrics with no CommitmentKind equivalent (requester_wait_time, agent_work_time, ...).
  unsupportedMetrics              Int      @default(0)
  /// Policies whose policy_metrics produced no usable target for any CommitmentKind.
  policiesWithNoUsableTargets     Int      @default(0)
  /// Policies whose schedule_id pointed at a schedule not (yet) imported — fell back to the always-open default calendar.
  policiesWithUnresolvedSchedule  Int      @default(0)
  /// Previously-imported policies archived this run because they're gone from Zendesk's current listing (E-9).
  policiesArchived                Int      @default(0)
  /// Cases with at least one active commitment whose current attributes match no active policy version, as of this run's commitment pass.
  casesWithNoMatchingPolicy       Int      @default(0)
  updatedAt                       DateTime @updatedAt
  organization                    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("sla_import_summaries")
}

/// Working hours, timezone, holidays. Versioned like SLAPolicy.
model BusinessCalendar {
  id             String                    @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime                  @default(now())
  /// Zendesk business hours schedule id when imported (roadmap step 13); null for the always-open default calendar.
  externalId     String?
  /// Imported vs native (D12, Phase 4). Backfilled from `externalId` for
  /// every pre-Phase-4 row: non-null externalId -> imported.
  source         PolicySource              @default(native)
  versions       BusinessCalendarVersion[]
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Customers whose commitments are pinned to this calendar instead of
  /// whatever their matched policy would otherwise resolve to (roadmap step 24).
  customers      Customer[]
  /// Organizations that picked this calendar as their default (Phase 4 task 4.7).
  defaultForOrganizations Organization[]   @relation("OrganizationDefaultCalendar")

  @@unique([organizationId, externalId])
  @@map("business_calendars")
}

model BusinessCalendarVersion {
  id             String             @id @default(cuid())
  calendarId     String
  version        Int
  timezone       String
  weekly         Json
  holidays       String[]
  /// Optional `{ "YYYY-MM-DD": "name" }` map for the dates in `holidays`
  /// (Phase 4 task 4.5/4.6). Nullable/additive so the engine's pure
  /// `holidays: string[]` type and every pre-Phase-4 version is unaffected;
  /// purely a display concern, never read by packages/core.
  holidayNames   Json?
  /// The native calendar editor's original holiday inputs — `{ date, name,
  /// recurring }[]` (4h), exactly as `NativeHolidayInput` — separate from
  /// `holidays`/`holidayNames`, which only ever hold the flat, expanded
  /// occurrences the engine reads. Without this, reopening the editor could
  /// only ever reconstruct one-off dates from `holidays`, silently losing
  /// every recurring holiday's recurrence back to a pile of one-off dates on
  /// the next save. Null for a version with no native-editor holiday inputs
  /// (every pre-4h version, and every Zendesk-imported version, which has no
  /// recurrence concept at all) — the read layer falls back to treating
  /// `holidays` as one-off dates in that case, unchanged prior behavior.
  /// Never read by packages/core.
  holidayDefinitions Json?
  alwaysOpen     Boolean            @default(false)
  /// `imported` mirrors the provider's schedule; `override` is a manual edit
  /// on top of an imported calendar; `native` belongs to a calendar that was
  /// never imported (Phase 4 / D12, closing E-18).
  source         VersionSource      @default(imported)
  createdAt      DateTime           @default(now())
  calendar       BusinessCalendar   @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  commitments    Commitment[]
  policyVersions SLAPolicyVersion[]
  /// Customers whose calendar override (4d) is frozen onto this exact
  /// version — the inverse of Customer.calendarVersionId.
  customerOverrides Customer[]      @relation("CustomerCalendarVersion")

  @@unique([calendarId, version])
  @@map("business_calendar_versions")
}

/// One obligation on one Case. Created once, resolved once. `policyVersionId`
/// and `calendarVersionId` are frozen at creation — the reproducibility
/// anchor that keeps historical numbers stable when today's policy changes —
/// but while the commitment is still active (unfinalized, uncancelled),
/// Active-Commitment Re-Resolution may update them in place, along with
/// `targetMinutes` and `dueAt`, when the Case's attributes change enough that
/// a different SLAPolicyVersion now applies (`runCommitmentReResolutionPipeline`
/// in @sla/commitments). `startedAt`, `cycleKey`, and this row's identity
/// never change; the prior policy/target is preserved in
/// `CommitmentPolicyChange`, never overwritten silently. A finalized
/// (`met`, or `breached` with `closedAt` set) or `cancelled` commitment is
/// never touched by re-resolution.
/// One SLA commitment on a case. `cycleKey` tells apart commitments of the
/// same kind on one case: single-cycle kinds (first_response, resolution)
/// always use "single"; next_reply has one commitment per reply cycle, keyed
/// by `nextReplyCycleKey` so a cycle keeps its row across re-evaluation. A
/// cycle that stops being derived is cancelled, never deleted.
model Commitment {
  id                String                     @id @default(cuid())
  caseId            String
  kind              CommitmentKind
  cycleKey          String                     @default("single")
  policyVersionId   String
  calendarVersionId String
  startedAt         DateTime
  targetMinutes     Int
  dueAt             DateTime
  status            CommitmentStatus           @default(on_track)
  closedAt          DateTime?
  createdAt         DateTime                   @default(now())
  calendarVersion   BusinessCalendarVersion    @relation(fields: [calendarVersionId], references: [id])
  case              Case                       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  policyVersion     SLAPolicyVersion           @relation(fields: [policyVersionId], references: [id])
  evaluations       Evaluation[]
  notifications     Notification[]
  notificationFailures NotificationFailure[]
  policyChanges     CommitmentPolicyChange[]

  @@unique([caseId, kind, cycleKey])
  @@index([status])
  @@map("commitments")
}

/// Immutable audit record of an active Commitment's policy/target/calendar
/// changing in place because the currently applicable SLA policy changed
/// (Active-Commitment Re-Resolution) — never written on commitment creation,
/// only when re-resolution actually finds a different policy version
/// applies. Rows are append-only: nothing here is ever updated or deleted
/// except by cascading with their Commitment. `reason` is a generic string
/// (e.g. `policy_driving_attribute_changed`), never specific to one Case
/// attribute — re-resolution has no priority/customer/tier-specific path.
model CommitmentPolicyChange {
  id                        String     @id @default(cuid())
  commitmentId              String
  previousPolicyVersionId   String
  newPolicyVersionId        String
  previousTargetMinutes     Int
  newTargetMinutes          Int
  previousCalendarVersionId String
  newCalendarVersionId      String
  changedAt                 DateTime
  reason                    String
  createdAt                 DateTime   @default(now())
  commitment                Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([commitmentId, changedAt])
  @@map("commitment_policy_changes")
}

/// A contiguous period during which one leg (support | engineering |
/// waiting_customer | unknown) held the work. Derived, recomputable from
/// NormalizedEvents at any time — never the source of truth itself.
model LegSpan {
  id         String        @id @default(cuid())
  caseId     String
  leg        LegKind
  confidence LegConfidence
  startedAt  DateTime
  endedAt    DateTime?
  note       String?
  createdAt  DateTime      @default(now())
  case       Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, startedAt])
  @@map("leg_spans")
}

/// A point-in-time computation of a Commitment. Immutable snapshot — a
/// breach is not a separate entity, it is an Evaluation with
/// status = "breached". `inputs` records exactly what produced this number,
/// so it can be re-derived and explained months later: its `lastEvent`
/// names the source event by its immutable RawEvent and the event's own
/// facts, never by a NormalizedEvent id (those are regenerated on every
/// normalization run). Durations are whole seconds so a sub-minute SLA
/// snapshot keeps its exact timing.
model Evaluation {
  id                String           @id @default(cuid())
  commitmentId      String
  evaluatedAt       DateTime
  elapsedSeconds    Int
  remainingSeconds  Int
  status            CommitmentStatus
  breachedBySeconds Int?
  /// The instant the SLA clock actually crossed its target
  /// (`evaluateCommitment`'s `effectiveDueAt`, working-minutes/calendar/pause
  /// aware), set only when `status = "breached"`. Distinct from
  /// `evaluatedAt`, which is only when this row was computed/persisted (a
  /// poll cycle, or a one-off historical backfill) — never the breach
  /// instant itself. Derived purely from events, so it's the same value no
  /// matter which evaluation cycle computed it. Null for a pre-migration row
  /// that hasn't been backfilled yet (see
  /// packages/commitments/src/scripts/backfill-breached-at.ts).
  breachedAt        DateTime?
  inputs            Json
  createdAt         DateTime         @default(now())
  commitment        Commitment       @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@index([commitmentId, evaluatedAt])
  @@map("evaluations")
}

/// What was sent, to whom, why. The dedup key on (commitmentId, threshold)
/// means a poll that runs twice cannot alert twice.
model Notification {
  id           String     @id @default(cuid())
  commitmentId String
  threshold    Int
  channel      String
  sentAt       DateTime   @default(now())
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, threshold])
  @@map("notifications")
}

/// Currently-failing alert candidates (Phase 6.4): every channel `dispatch.ts`
/// tried for this (commitmentId, threshold) errored, so no `Notification` row
/// exists yet and the worker will retry next cycle. Kept as its own table,
/// not a status on `Notification`, since a failed attempt leaves no
/// `Notification` row at all (the claim is deleted so retries stay possible)
/// — this is the only durable record that the attempt happened. Upserted on
/// every failed attempt (`attempts` increments, `lastFailedAt`/`error`
/// refresh) and deleted the moment any channel succeeds for that candidate.
model NotificationFailure {
  id            String     @id @default(cuid())
  commitmentId  String
  threshold     Int
  error         String
  attempts      Int        @default(1)
  firstFailedAt DateTime   @default(now())
  lastFailedAt  DateTime   @default(now())
  commitment    Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, threshold])
  @@map("notification_failures")
}

/// The only notification channel in v1 (Phase 10). One workspace per
/// organization — not modelled as an `Integration` because it neither
/// ingests `RawEvent`s nor advances a cursor, it only sends. `channelId` is
/// nullable because the OAuth install and the channel choice are two
/// separate steps in onboarding (Phase 11 step 8).
model SlackIntegration {
  id             String       @id @default(cuid())
  organizationId String       @unique
  accessToken    String
  teamId         String
  teamName       String
  botUserId      String
  channelId      String?
  channelName    String?
  installedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("slack_integrations")
}

/// Per-organization OAuth app credentials for a configurable integration
/// (zendesk, jira, slack — see ConfigurableIntegrationProvider in
/// @sla/db), set from the Integration settings UI. This is the only source
/// of these credentials — there is no global `.env` fallback. `provider` is
/// a plain string rather than `IntegrationProvider` because it also covers
/// slack, which — per `SlackIntegration`'s doc comment — was deliberately
/// never added to that enum.
model IntegrationConfig {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  clientId       String
  /// AES-256-GCM ciphertext, base64-encoded — see @sla/db's
  /// encryptSecret/decryptSecret. Never returned to the client in plaintext.
  clientSecret   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("integration_configs")
}

/// Per-organization SMTP configuration for the email notification channel
/// (alongside `SlackIntegration`), set from the Notifications settings UI.
/// One row per organization — there is no deployment-level SMTP fallback:
/// an organization that hasn't saved this row simply has no email channel,
/// the same nullable pattern `SlackIntegration` already uses. `security`
/// is stored explicitly rather than inferred from `port` because operators
/// run all three (None/STARTTLS/SSL-TLS) on non-standard ports.
model OrganizationEmailSettings {
  id             String        @id @default(cuid())
  organizationId String        @unique
  host           String
  port           Int
  security       EmailSecurity @default(starttls)
  username       String
  /// AES-256-GCM ciphertext, base64-encoded — see @sla/db's
  /// encryptSmtpPassword/decryptSmtpPassword. Never returned to the client
  /// in plaintext.
  password       String
  fromEmail      String
  fromName       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_email_settings")
}

enum EmailSecurity {
  none
  starttls
  ssl_tls
}

/// Shared by SLAPolicyVersion and BusinessCalendarVersion: `imported` mirrors
/// the provider's data; `override` is a manual edit on top of an imported
/// row (the importer only compares against the latest `imported` version, so
/// re-importing unchanged content never reverts an override — E-18);
/// `native` is a version of a policy/calendar that was never imported at all
/// (Phase 4 / D12).
enum VersionSource {
  imported
  override
  native
}

/// Whether an SLAPolicy or BusinessCalendar originates from a provider
/// (Zendesk) or was created directly in Watchtower (Phase 4 / D12). Imported
/// policies are matched first, ranked by `position`; native policies are
/// only considered when no imported policy matches, ranked by specificity.
enum PolicySource {
  imported
  native
}

enum UserRole {
  owner
  member
}

enum IntegrationProvider {
  zendesk
  jira
  linear
  intercom
  github
}

enum IntegrationStatus {
  connected
  disconnected
  reauth_required
  // Roadmap step 32: the token still works but the provider answered 403 —
  // the connecting user lost access on the provider's side. Set by the
  // worker cycle (and the Zendesk/Jira webhook receivers); cleared back to
  // `connected` by the next clean sync, since the fix needs no reconnect.
  permission_denied
}

enum CaseLinkMethod {
  official_link
  remote_link
  pattern
  manual
}

enum LinkConfidence {
  certain
  probable
}

enum LegKind {
  support
  engineering
  waiting_customer
  unknown
}

enum LegConfidence {
  certain
  inferred
  unknown
}

enum CommitmentKind {
  first_response
  resolution
  next_reply
}

enum CommitmentStatus {
  on_track
  at_risk
  met
  breached
  cancelled
}

/// Singleton row (`id` is always `"singleton"`) holding the worker's
/// persisted polling configuration and last-observed run state — see
/// `@sla/db`'s `worker-settings.ts`. There is exactly one worker process for
/// the whole deployment: it polls every organization on the same two shared
/// timers (`apps/worker/src/index.ts`), it is not per-organization
/// scheduling, so this config is deliberately global rather than living on
/// `Organization`. `activePollIntervalMs`/`reconciliationIntervalMs` start
/// out equal to the `WORKER_ACTIVE_POLL_MS`/`WORKER_RECONCILIATION_MS` env
/// vars (bootstrap defaults for a fresh install); once a platform operator
/// (see `PLATFORM_ADMIN_EMAILS`, `apps/web/src/lib/authz.ts`) saves a
/// change from the Monitoring settings page, this row is authoritative and
/// the env vars are no longer consulted.
model WorkerSettings {
  id                         String    @id @default("singleton")
  activePollIntervalMs       Int
  reconciliationIntervalMs   Int
  /// Written by the worker at the end of every tick, success or failure —
  /// proof the process is alive and looping, independent of whether a cycle
  /// actually completed. Used to tell "stopped" apart from "degraded".
  lastHeartbeatAt            DateTime?
  /// Written only when an active-set-poll cycle actually completes (did not
  /// throw); `lastActivePollFailures` is that cycle's per-organization
  /// failure count (`CycleResult.failures.length`), not a retry counter.
  lastActivePollAt           DateTime?
  lastActivePollFailures     Int?
  lastReconciliationAt       DateTime?
  lastReconciliationFailures Int?
  /// The actual next execution time the worker's own scheduler has queued
  /// (`apps/worker/src/index.ts`'s `scheduleNext`) — written at the moment a
  /// `setTimeout` is armed, using whatever interval is persisted at that
  /// instant. Deliberately NOT derived as `last*At + *IntervalMs` anywhere
  /// (server read model or UI): a cycle can take time to run, and the
  /// interval can change between the last completed run and the next
  /// scheduling decision, so only the scheduler itself knows the true next
  /// run time. Null until the scheduler has armed a timer for that kind at
  /// least once (e.g. before the worker's first boot tick completes).
  nextActivePollAt           DateTime?
  nextReconciliationAt       DateTime?

  @@map("worker_settings")
}
