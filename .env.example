# Postgres connection string used by packages/db (Prisma) and apps/web, apps/worker.
DATABASE_URL="postgresql://user:password@localhost:5432/sla_breach_monitoring?schema=public"

# apps/web
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated emails of the platform operators who run this deployment.
# Only these accounts (checked server-side, not a UserRole) may change
# Worker/Monitoring settings; every tenant, including an org owner, gets a
# read-only view.
PLATFORM_ADMIN_EMAILS=""
# Dedicated key material for encrypting/decrypting the Zendesk/Jira/Slack
# client secrets saved from the Integrations settings UI (see @sla/db's
# encryptSecret/decryptSecret) — kept separate from NEXTAUTH_SECRET so
# rotating one never invalidates the other. Required for those integrations
# to work.
INTEGRATION_CONFIG_ENCRYPTION_KEY=""
# Dedicated key material for encrypting/decrypting the OAuth access/refresh
# tokens saved for each connected Zendesk/Jira/Intercom/Linear/GitHub/Slack
# integration (see @sla/db's encryptCredentials/decryptCredentials) — kept
# separate from INTEGRATION_CONFIG_ENCRYPTION_KEY/NEXTAUTH_SECRET/
# SMTP_ENCRYPTION_KEY so rotating one never invalidates the others. Required
# for connecting any integration to work. Existing plaintext rows from
# before this key existed are migrated in place with `pnpm db:encrypt-tokens`.
INTEGRATION_TOKEN_ENCRYPTION_KEY=""

# Email notifications (the second alert channel alongside Slack) are
# configured per-organization from the Notifications settings UI, stored in
# `OrganizationEmailSettings` — there is no deployment-level SMTP_HOST/
# SMTP_USER/etc fallback. This is the one deployment-level secret the
# feature still needs: the key used to encrypt/decrypt each organization's
# saved SMTP password at rest (see @sla/db's encryptSmtpPassword/
# decryptSmtpPassword) — kept separate from INTEGRATION_CONFIG_ENCRYPTION_KEY/
# NEXTAUTH_SECRET so rotating one never invalidates the others. Required for
# the Notifications settings UI's email configuration to work.
SMTP_ENCRYPTION_KEY=""

# apps/web + apps/worker — deployment-owned SMTP, shared by every
# deployment-level email concern: account-lifecycle email sent from apps/web
# (invitations, password resets, email verification — roadmap D8) and
# apps/worker's stalled-cycle ops alert below. Deliberately separate from
# `OrganizationEmailSettings` above (per-org, opt-in, SLA-notification-only,
# customer-owned) — that's the boundary that matters; there's no technical
# reason for a *second* deployment-owned SMTP transport once both consumers
# go through the same `sendEmail`. These flows can fire before an
# organization has ever configured its own SMTP — the very first invite, or
# a password reset for an owner who never opened Settings → Notifications —
# so they cannot depend on optional per-tenant configuration. Required for
# invitations, password resets and email verification to work; if left
# blank, those flows fail explicitly (loud error, not a silent no-op or
# fallback to an organization's own SMTP). The worker's ops alert treats it
# as optional — see OPS_ALERT_EMAIL below.
DEPLOYMENT_SMTP_HOST=""
DEPLOYMENT_SMTP_PORT=587
DEPLOYMENT_SMTP_SECURITY=starttls
DEPLOYMENT_SMTP_USER=""
DEPLOYMENT_SMTP_PASSWORD=""
DEPLOYMENT_SMTP_FROM=""

# apps/worker
WORKER_ACTIVE_POLL_MS=300000
WORKER_RECONCILIATION_MS=1800000

# Observability (apps/web, apps/worker) — see docs/deployment.md's "Health
# checks and observability" section. Every var below is optional; leaving
# any of them blank just skips that feature/channel, never a crash — the
# same "missing credentials mean skip" convention as everything else here.
#
# Error tracking (e.g. https://sentry.io). Read by both apps
# (apps/web/sentry.{server,edge}.config.ts, apps/worker/src/sentry.ts).
SENTRY_DSN=""
# Build-time only (apps/web image, roadmap 7.6): upload source maps so Sentry
# shows readable stack traces. All three must be set or nothing is uploaded.
# The auth token needs project:releases + org:read scopes. SENTRY_URL is only
# for self-hosted Sentry.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# apps/worker only — the port its liveness endpoint (GET /health) listens
# on inside the container. Must match apps/worker/Dockerfile's HEALTHCHECK
# and docker-compose.prod.yml's worker `expose` if you change it.
WORKER_HEALTH_PORT=8081
# apps/worker only — any number of workers may run against one database; they
# split the organizations through per-organization leases (docs/deployment.md,
# "Running multiple workers"). A Postgres advisory lock now only elects the one
# worker that runs the stalled-work watchdog: a worker that isn't it retries
# this often; the holder pings its lock connection this often.
WORKER_LOCK_RETRY_MS=15000
WORKER_LOCK_PING_MS=30000
# apps/worker only — how many organizations ONE worker processes at once
# (integrations within an organization stay sequential). Default 5; 1 is
# fully sequential. Total parallelism = this x the number of workers.
ORGANIZATION_CONCURRENCY=5
# apps/worker only — multi-worker lease tuning; the defaults are fine.
# A crashed worker's organizations are taken over this long after its last
# lease renewal; an idle worker sleeps at most CLAIM_POLL between claim
# attempts; a stopping worker lets in-flight organizations finish for up to
# SHUTDOWN_GRACE before releasing them.
# WORKER_LEASE_TTL_MS=60000
# WORKER_CLAIM_POLL_MS=1000
# WORKER_SHUTDOWN_GRACE_MS=30000
# Each worker's own Postgres pool. Unset = 2 x ORGANIZATION_CONCURRENCY + 4.
# Connections add up across workers: see "Connection budget" in
# docs/deployment.md before raising it or running many workers.
# DATABASE_POOL_MAX=
# apps/worker only — where a "worker cycle hasn't completed in a while"
# alert goes (this is for you, the deployment owner, not your customers —
# their SLA breach alerts are the separate per-organization Slack/email
# channels configured from the app's own Notifications settings). Slack
# uses a plain incoming-webhook URL, not the per-org Slack OAuth app.
OPS_ALERT_SLACK_WEBHOOK_URL=""
# The recipient for the email channel of the ops alert above. Sent through
# the shared DEPLOYMENT_SMTP_* config above, not its own SMTP credentials —
# if DEPLOYMENT_SMTP_* isn't set, email alerting simply stays off (the same
# "missing credentials mean skip" convention as everything else here).
OPS_ALERT_EMAIL=""
