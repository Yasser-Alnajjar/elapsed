{
  "name": "sla-breach-monitoring",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "web:dev": "pnpm -r --filter=./apps/web dev",
    "web:build": "pnpm -r --filter=./apps/web build",
    "worker:dev": "pnpm -r --filter=./apps/worker dev",
    "worker:start": "pnpm -r --filter=./apps/worker start",
    "worker:build": "pnpm -r --filter=./apps/worker build",
    "type-check": "pnpm -r run type-check",
    "test": "vitest run",
    "test:db:prepare": "DATABASE_URL=\"$TEST_DATABASE_URL\" pnpm --filter @sla/db exec prisma migrate deploy",
    "test:watch": "vitest",
    "db:encrypt-tokens": "pnpm --filter @sla/db run encrypt-tokens",
    "db:seed:perf-baseline": "pnpm --filter @sla/db run seed:perf-baseline",
    "db:seed:test-customers": "pnpm --filter @sla/worker run seed:test-customers",
    "db:seed:test-customers:validate": "pnpm --filter @sla/worker run seed:test-customers:validate"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
